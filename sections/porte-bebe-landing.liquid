          </div>
          <div class="pbl-split__media">
            {%- if section.settings.weight_image != blank -%}
              {{ section.settings.weight_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
            {%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ 6. MAINS LIBRES ============ {%- endcomment -%}
  {%- if section.settings.hands_title != blank -%}
    <div class="pbl-block pbl-block--tight">
      <div class="pbl-container">
        <div class="pbl-split pbl-split--reverse">
          <div>
            <h3>{{ section.settings.hands_title }}</h3>
            <div class="pbl-pills">
              {%- if section.settings.hands_badge_1 != blank -%}
                <div class="pbl-pill"><span class="ico">🤲</span><span>{{ section.settings.hands_badge_1 }}</span></div>
              {%- endif -%}
              {%- if section.settings.hands_badge_2 != blank -%}
                <div class="pbl-pill"><span class="ico">👶</span><span>{{ section.settings.hands_badge_2 }}</span></div>
              {%- endif -%}
            </div>
          </div>
          <div class="pbl-split__media">
            {%- if section.settings.hands_image != blank -%}
              {{ section.settings.hands_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
            {%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ 7. CONÇU POUR LA VRAIE VIE ============ {%- endcomment -%}
  {%- assign life_blocks = section.blocks | where: 'type', 'life_point' -%}
  {%- if section.settings.life_title != blank or life_blocks.size > 0 -%}
    <div class="pbl-block pbl-block--tight">
      <div class="pbl-container">
        <div class="pbl-split">
          <div>
            <h3>{{ section.settings.life_title }}</h3>
            <div class="pbl-pills">
              {%- for block in life_blocks -%}
                <div class="pbl-pill" {{ block.shopify_attributes }}>
                  <span class="ico">{{ block.settings.icon }}</span>
                  <span><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %} : {{ block.settings.text }}{% endif %}</span>
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="pbl-split__media">
            {%- if section.settings.life_image != blank -%}
              {{ section.settings.life_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
            {%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ 8. MATIÈRES ============ {%- endcomment -%}
  {%- assign mat_blocks = section.blocks | where: 'type', 'material' -%}
  {%- if section.settings.mat_title != blank or mat_blocks.size > 0 -%}
    <div class="pbl-block pbl-block--tight">
      <div class="pbl-container">
        <div class="pbl-split pbl-split--reverse">
          <div>
            <h3>{{ section.settings.mat_title }}</h3>
            <div class="pbl-pills">
              {%- for block in mat_blocks -%}
                <div class="pbl-pill" {{ block.shopify_attributes }}>
                  <span class="ico">{{ block.settings.icon }}</span>
                  <span><strong>{{ block.settings.title }}</strong>{% if block.settings.text != blank %} : {{ block.settings.text }}{% endif %}</span>
                </div>
              {%- endfor -%}
            </div>
          </div>
          <div class="pbl-split__media">
            {%- if section.settings.mat_image != blank -%}
              {{ section.settings.mat_image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
            {%- else -%}{{ 'image' | placeholder_svg_tag }}{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ 9. PREUVE SOCIALE ============ {%- endcomment -%}
  {%- if section.settings.proof_number != blank -%}
    <div class="pbl-block" style="background: var(--pbl-soft);">
      <div class="pbl-container">
        {%- if section.settings.proof_title != blank -%}
          <h2 class="pbl-h2">{{ section.settings.proof_title }}</h2>
        {%- endif -%}
        <div class="pbl-proof">
          <div class="pbl-proof__grid">
            {%- if section.settings.proof_image_1 != blank -%}{{ section.settings.proof_image_1 | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
            {%- if section.settings.proof_image_2 != blank -%}{{ section.settings.proof_image_2 | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
            {%- if section.settings.proof_image_3 != blank -%}{{ section.settings.proof_image_3 | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag }}{%- endif -%}
            {%- if section.settings.proof_image_4 != blank -%}{{ section.settings.proof_image_4 | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
          </div>
          <div>
            <p class="pbl-proof__num">{{ section.settings.proof_number }}</p>
            <p style="margin:0 0 .8rem; font-weight:600;">{{ section.settings.proof_label }}</p>
            <span class="pbl-stars" aria-hidden="true">★★★★★</span>
            <p style="opacity:.65; font-size:1.25rem; margin:.4rem 0 0;">{{ section.settings.proof_note }}</p>
