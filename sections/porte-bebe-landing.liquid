  {%- comment -%} ============ 4. TÉMOIGNAGES ============ {%- endcomment -%}
  {%- assign testi_blocks = section.blocks | where: 'type', 'testimonial' -%}
  {%- if testi_blocks.size > 0 -%}
    <div class="pbl-block">
      <div class="pbl-container">
        <div class="pbl-testis">
          {%- for block in testi_blocks -%}
            <article class="pbl-testi" {{ block.shopify_attributes }}>
              <div class="pbl-testi__img">
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
                {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
              </div>
              <div class="pbl-testi__body">
                <span class="pbl-stars" aria-hidden="true">★★★★★</span>
                <p>{{ block.settings.text }}</p>
                <p class="pbl-testi__name">{{ block.settings.name }}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ 5. POIDS MIEUX RÉPARTI ============ {%- endcomment -%}
  {%- assign weight_blocks = section.blocks | where: 'type', 'weight_point' -%}
  {%- if section.settings.weight_title != blank or weight_blocks.size > 0 -%}
    <div class="pbl-block pbl-block--tight">
      <div class="pbl-container">
