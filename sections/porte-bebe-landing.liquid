  {%- endif -%}

  {%- comment -%} ============ 10. AVIS CLIENTS ============ {%- endcomment -%}
  {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
  {%- if review_blocks.size > 0 -%}
    <div class="pbl-block">
      <div class="pbl-container">
        {%- if section.settings.reviews_title != blank -%}
          <h2 class="pbl-h2" style="text-align:left;">{{ section.settings.reviews_title }}</h2>
        {%- endif -%}
        <div class="pbl-reviews__head">
          <span class="pbl-reviews__score">{{ section.settings.reviews_score }}</span>
          <div>
            <span class="pbl-stars" aria-hidden="true">★★★★★</span><br>
            <small style="opacity:.65">{{ section.settings.reviews_count }}</small>
          </div>
        </div>
        <div class="pbl-reviews__grid">
          {%- for block in review_blocks -%}
            <article class="pbl-review" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}
              {%- endif -%}
              <div class="pbl-review__body">
                <div class="pbl-review__meta">
                  <span class="pbl-stars" style="font-size:1.15rem" aria-hidden="true">★★★★★</span>
                  {%- if block.settings.verified -%}
                    <span class="pbl-review__verified">✓ Achat vérifié</span>
                  {%- endif -%}
                </div>
                <p class="pbl-review__name">{{ block.settings.name }}</p>
                <p>{{ block.settings.text }}</p>
              </div>
            </article>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ 11. FAQ ============ {%- endcomment -%}
  {%- assign faq_blocks = section.blocks | where: 'type', 'faq' -%}
  {%- if faq_blocks.size > 0 -%}
    <div class="pbl-block" style="background: var(--pbl-soft);">
      <div class="pbl-container">
        {%- if section.settings.faq_title != blank -%}
          <h2 class="pbl-h2">{{ section.settings.faq_title }}</h2>
        {%- endif -%}
        <div class="pbl-faq">
          {%- for block in faq_blocks -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="pbl-faq__a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ============ Barre sticky mobile ============ {%- endcomment -%}
  {%- if section.settings.show_sticky and p != blank -%}
    <div class="pbl-sticky" data-pbl-sticky>
      <span class="pbl-sticky__price" data-pbl-sticky-price>{{ current_variant.price | money }}</span>
      <button type="button" class="pbl-atc" data-pbl-sticky-btn>{{ section.settings.atc_label }}</button>
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('pbl-{{ section.id }}');
    if (!root) return;

    /* --- Galerie : clic sur miniature --- */
    var main = root.querySelector('[data-pbl-main] img');
    var thumbs = root.querySelectorAll('[data-pbl-thumbs] button');
    thumbs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (main) {
          main.src = btn.dataset.full;
          main.removeAttribute('srcset');
        }
        thumbs.forEach(function (b) { b.classList.remove('is-active'); });
        btn.classList.add('is-active');
      });
    });

    /* --- Offres : quantité + prix affiché --- */
    var form = root.querySelector('#pbl-form');
    if (form) {
      var qtyInput = form.querySelector('[data-pbl-qty]');
      var variantInput = form.querySelector('[data-pbl-variant-id]');
      var atcPrice = form.querySelector('[data-pbl-atc-price]');
      var stickyPrice = root.querySelector('[data-pbl-sticky-price]');

      function syncOffer(radio) {
        if (qtyInput) qtyInput.value = radio.value;
        if (atcPrice && radio.dataset.price) atcPrice.textContent = radio.dataset.price;
        if (stickyPrice && radio.dataset.price) stickyPrice.textContent = radio.dataset.price;
      }
      var radios = form.querySelectorAll('[data-pbl-offer]');
      radios.forEach(function (r) {
        r.addEventListener('change', function () { syncOffer(r); });
        if (r.checked) syncOffer(r);
      });

      /* Variante : on prend le 1er sélecteur visible de l'offre cochée */
      form.addEventListener('change', function () {
        var checked = form.querySelector('[data-pbl-offer]:checked');
        var scope = checked ? checked.closest('.pbl-offer') : form;
        var select = scope ? scope.querySelector('[data-pbl-variant-select]') : null;
        if (!select) select = form.querySelector('[data-pbl-variant-select]');
        if (select && variantInput) variantInput.value = select.value;
      });
    }

    /* --- Sticky mobile : visible après scroll --- */
    var sticky = root.querySelector('[data-pbl-sticky]');
    if (sticky && form) {
      var stickyBtn = root.querySelector('[data-pbl-sticky-btn]');
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function () {
          form.requestSubmit ? form.requestSubmit() : form.submit();
        });
      }
      var trigger = root.querySelector('.pbl-atc');
      if ('IntersectionObserver' in window && trigger) {
        new IntersectionObserver(function (entries) {
          sticky.classList.toggle('is-visible', !entries[0].isIntersecting);
        }, { threshold: 0 }).observe(trigger);
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Landing produit bébé",
  "tag": "section",
  "class": "section-pbl",
  "settings": [
    { "type": "product", "id": "product", "label": "Produit (laisser vide sur une page produit)" },
    { "type": "header", "content": "En-tête produit" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Conçu en France pour bébés OK" },
    { "type": "text", "id": "custom_title", "label": "Titre personnalisé (sinon titre du produit)" },
    { "type": "text", "id": "rating_text", "label": "Texte de notation", "default": "4.8/5 — plus de 500 avis" },
    { "type": "textarea", "id": "short_desc", "label": "Description courte", "default": "Gardez bébé apaisé contre vous, les mains libres, sans douleur au dos ni aux bras. Prêt en quelques secondes, où que vous soyez." },
    { "type": "text", "id": "offers_title", "label": "Titre des offres", "default": "Offre de printemps" },
    { "type": "text", "id": "atc_label", "label": "Texte du bouton d'achat", "default": "Ajouter au panier" },
    { "type": "text", "id": "reassurance", "label": "Réassurance (séparer par | )", "default": "🚚 Expédié sous 48h | 💜 Satisfait ou remboursé 30 jours" },
    { "type": "checkbox", "id": "show_sticky", "label": "Barre d'achat fixe sur mobile", "default": true },

    { "type": "header", "content": "Section — Étapes" },
    { "type": "text", "id": "steps_title", "label": "Titre", "default": "Le porte-bébé qui apaise bébé, sans vous faire mal." },
    { "type": "text", "id": "steps_sub", "label": "Sous-titre" },

    { "type": "header", "content": "Section — Comparatif" },
    { "type": "text", "id": "vs_title", "label": "Titre", "default": "Notre porte-bébé face aux autres" },
    { "type": "image_picker", "id": "vs_image_us", "label": "Image — notre produit" },
    { "type": "image_picker", "id": "vs_image_them", "label": "Image — produit classique" },

    { "type": "header", "content": "Section — Poids mieux réparti" },
    { "type": "text", "id": "weight_title", "label": "Titre", "default": "Un poids mieux réparti, ça change tout." },
    { "type": "image_picker", "id": "weight_image", "label": "Image (avant / après)" },

    { "type": "header", "content": "Section — Mains libres" },
    { "type": "text", "id": "hands_title", "label": "Titre", "default": "Quand il veut les bras… mais que vous êtes occupés." },
    { "type": "text", "id": "hands_badge_1", "label": "Badge 1", "default": "Bébé apaisé immédiatement" },
    { "type": "text", "id": "hands_badge_2", "label": "Badge 2", "default": "100% mains libres" },
    { "type": "image_picker", "id": "hands_image", "label": "Image" },

    { "type": "header", "content": "Section — Conçu pour la vraie vie" },
    { "type": "text", "id": "life_title", "label": "Titre", "default": "Conçu pour la vraie vie" },
    { "type": "image_picker", "id": "life_image", "label": "Image" },

    { "type": "header", "content": "Section — Matières" },
    { "type": "text", "id": "mat_title", "label": "Titre", "default": "Doux pour lui. Solide pour vous." },
    { "type": "image_picker", "id": "mat_image", "label": "Image (couches de tissu)" },

    { "type": "header", "content": "Section — Preuve sociale" },
    { "type": "text", "id": "proof_title", "label": "Titre", "default": "Testé et approuvé par des milliers de parents" },
    { "type": "text", "id": "proof_number", "label": "Grand chiffre", "default": "23 000+" },
    { "type": "text", "id": "proof_label", "label": "Libellé", "default": "Parents qui ont sauvé leur dos" },
    { "type": "text", "id": "proof_note", "label": "Note", "default": "Moyenne basée sur les avis vérifiés" },
    { "type": "image_picker", "id": "proof_image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "proof_image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "proof_image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "proof_image_4", "label": "Image 4" },

    { "type": "header", "content": "Section — Avis clients" },
    { "type": "text", "id": "reviews_title", "label": "Titre", "default": "Avis des clients" },
    { "type": "text", "id": "reviews_score", "label": "Note globale", "default": "4.8" },
    { "type": "text", "id": "reviews_count", "label": "Nombre d'avis", "default": "568 avis" },

    { "type": "header", "content": "Section — FAQ" },
    { "type": "text", "id": "faq_title", "label": "Titre", "default": "FAQ" },

